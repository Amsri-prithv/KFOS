rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zero-Trust Architecture: Deny all direct client-side reads and writes.
    // The KFOS application operates exclusively via a server-mediated Express API
    // using the Firebase Admin SDK, ensuring strict role-based access control,
    // atomic validations, automatic audit logging, and input sanitization.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
