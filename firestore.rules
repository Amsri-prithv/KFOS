rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // E2E verification collection
    match /_systemTests/{testId} {
      allow read, write: if true;
    }

    // All collections accessible for server-side hybrid REST API & Admin SDK operations
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
