# GEMINI_API_KEY: Required for Gemini AI NLU & Agent API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# TELEGRAM_BOT_TOKEN: Telegram Bot API Token for incoming field staff voice notes and webhook
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_WEBHOOK_SECRET: Secret token for verifying Telegram webhook requests (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=""

# JWT_SECRET: Secret key for signing user auth tokens
JWT_SECRET=""

# FIREBASE_PROJECT_ID: Firebase Project ID
FIREBASE_PROJECT_ID=""

# FIREBASE_DATABASE_ID: Firestore Database ID
FIREBASE_DATABASE_ID=""

# ROLE ACCESS PINS: Required for user logins (No fallback in production)
FOUNDER_PIN=""
ADMIN_PIN=""
SALES_PIN=""
OPS_PIN=""
FINANCE_PIN=""
SUPPORT_PIN=""

# NODE_ENV: Environment mode (development / production)
NODE_ENV="development"
