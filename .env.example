# GEMINI_API_KEY: Required for Gemini 3.6 Flash AI NLU & Agent API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# TELEGRAM_BOT_TOKEN: Telegram Bot API Token for incoming field staff voice notes and webhook
TELEGRAM_BOT_TOKEN=""

# ADMIN_PIN: Master Admin Access PIN for sensitive inventory/order modifications (Default: 6124)
ADMIN_PIN="6124"

# JWT_SECRET: Secret key for signing user auth tokens
JWT_SECRET="kfos_jwt_secret_key_change_in_production"

# FIREBASE_PROJECT_ID: Firebase Project ID
FIREBASE_PROJECT_ID=""

# FIREBASE_DATABASE_ID: Firestore Database ID (Optional, defaults to (default))
FIREBASE_DATABASE_ID=""

# DATABASE_URL: [OBSOLETE / UNUSED] Application database is Firebase Cloud Firestore
# DATABASE_URL=""

# NODE_ENV: Environment mode (development / production)
NODE_ENV="development"
